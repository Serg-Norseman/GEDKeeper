<forms:CommonDialog
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="clr-namespace:GKUI.Forms"
    x:Class="GKUI.Forms.ProgressDlg">

    <StackLayout Orientation="Vertical" Spacing="10">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">
            <Label x:Name="lblTitle" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" />
            <ProgressBar x:Name="ProgressBar1" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" />

            <Label x:Name="lblTimePassed" Grid.Column="0" Grid.Row="2" />
            <Label x:Name="lblPassedVal" HorizontalTextAlignment="End" Grid.Column="1" Grid.Row="2" />

            <Label x:Name="lblTimeRemain" Grid.Column="0" Grid.Row="3" />
            <Label x:Name="lblRemainVal" HorizontalTextAlignment="End" Grid.Column="1" Grid.Row="3" />

            <Label x:Name="lblTimeTotal" Grid.Column="0" Grid.Row="4" />
            <Label x:Name="lblTotalVal" HorizontalTextAlignment="End" Grid.Column="1" Grid.Row="4" />
        </Grid>
    </StackLayout>
</forms:CommonDialog>
