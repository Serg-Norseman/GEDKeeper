<?xml version="1.0" encoding="utf-8" ?>
<forms:CommonDialog
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="clr-namespace:GKUI.Forms" xmlns:plat="clr-namespace:GKUI.Platform"
    xmlns:contr="clr-namespace:GKCore.Controllers;assembly=GKCore"
    xmlns:mvp="clr-namespace:GKCore.Design.Views;assembly=GKCore"
    xmlns:comcom="clr-namespace:GKUI.Components"
    x:Class="GKUI.Forms.AboutPage"
    x:TypeArguments="mvp:IAboutDlg, contr:AboutDlgController">

    <Grid RowSpacing="8" Padding="8" RowDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto, Auto">

        <Image Source="{plat:ImageResourceExt Resources.image_logo.png}" Aspect="AspectFit" Grid.Row="0" />
        <Label x:Name="lblVersion" FontAttributes="Bold" FontSize="12" Grid.Row="1" />
        <Label x:Name="lblCopyright" FontAttributes="Bold" FontSize="12" Grid.Row="2" />

        <comcom:HyperLabel x:Name="lblProjSite" FontAttributes="Bold" Grid.Row="4" Text="https://gedkeeper.net/" />
        <comcom:HyperLabel x:Name="lblMail" FontAttributes="Bold" Grid.Row="5" Text="mailto:gedkeeper@yandex.ru" />
        <comcom:HyperLabel x:Name="lblForum" FontAttributes="Bold" Grid.Row="6" />
        <comcom:HyperLabel x:Name="lblChannel" FontAttributes="Bold" Grid.Row="7" />

    </Grid>

</forms:CommonDialog>
