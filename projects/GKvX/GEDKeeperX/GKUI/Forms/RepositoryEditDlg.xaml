<?xml version="1.0" encoding="UTF-8"?>
<forms:CommonDialog
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comcom="clr-namespace:GKUI.Components"
    xmlns:forms="clr-namespace:GKUI.Forms"
    xmlns:plat="clr-namespace:GKUI.Platform"
    xmlns:contr="clr-namespace:GKCore.Controllers;assembly=GKCore"
    xmlns:mvp="clr-namespace:GKCore.Design.Views;assembly=GKCore"
    x:Class="GKUI.Forms.RepositoryEditDlg"
    x:TypeArguments="mvp:IRepositoryEditDlg, contr:RepositoryEditDlgController">

    <Grid Style="{StaticResource paddedGrid88}" RowDefinitions="Auto, *, Auto">

        <Border Style="{StaticResource RoundBorder}" VerticalOptions="Start" HorizontalOptions="Fill" Grid.Row="0">
            <Grid ColumnSpacing="4" ColumnDefinitions="Auto, *">
                <Label x:Name="lblName" Grid.Column="0" />
                <Entry x:Name="txtName" Grid.Column="1" HorizontalOptions="Fill" />
            </Grid>
        </Border>

        <comcom:GKTabControl x:Name="tabsData" HorizontalOptions="Fill" VerticalOptions="Fill" Grid.Row="1">
            <comcom:GKTabControl.ItemSource>
                <comcom:TabPage x:Name="pageNotes">
                    <comcom:GKSheetList x:Name="fNotesList" />
                </comcom:TabPage>

                <comcom:TabPage x:Name="pageUserRefs">
                    <comcom:GKSheetList x:Name="fUserRefList" />
                </comcom:TabPage>
            </comcom:GKTabControl.ItemSource>
        </comcom:GKTabControl>

        <Grid Style="{StaticResource dlgGridFooter}" Grid.Row="2" ColumnDefinitions="Auto, *, Auto, Auto">
            <Button x:Name="btnAddress" Grid.Column="0" Clicked="btnAddress_Click" />
            <BoxView Grid.Column="1" VerticalOptions="Fill" />
            <Button x:Name="btnAccept" Grid.Column="2" Style="{StaticResource dlgBtn}" ImageSource="{plat:ImageResourceExt Resources.btn_accept.gif}" Clicked="AcceptClickHandler" />
            <Button x:Name="btnCancel" Grid.Column="3" Style="{StaticResource dlgBtn}" ImageSource="{plat:ImageResourceExt Resources.btn_cancel.gif}" Clicked="CancelClickHandler" />
        </Grid>

    </Grid>

</forms:CommonDialog>
