<?xml version="1.0" encoding="utf-8"?>
<Dialog xmlns="http://schema.picoe.ca/eto.forms" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:comcom="clr-namespace:GKUI.Components;assembly=GKComponents"
  x:Class="GKUI.Forms.TSForm"
  Title="TSForm">

  <TableLayout Style="paddedTable8">
    <TableRow>
      <Panel Padding="4">
        <StackLayout Orientation="Horizontal" Spacing="4">
          <StackLayout Orientation="Vertical" Spacing="4">
            <StackLayout Orientation="Horizontal" Spacing="4">
              <Label x:Name="lblFile" Text="File:" />
              <TextBox x:Name="txtFile" ReadOnly="True" Width="680" />
              <Button x:Name="btnSelectFile" Text="Select file..." Width="122" Click="btnSelectFile_ClickAsync" />
            </StackLayout>

            <CheckBox x:Name="chkOnlyModified" Text="Only modified" CheckedChanged="chkOnlyModified_CheckStateChanged" />

            <StackLayout Orientation="Horizontal" Spacing="4">
              <Button x:Name="btnSyncRecords" Text="Sync Records..." Width="122" Click="btnSyncRecords_Click" />
              <Button x:Name="btnAcceptChange" Text="Accept change" Width="122" Click="btnAcceptChange_Click" />
            </StackLayout>
          </StackLayout>
        </StackLayout>
      </Panel>
    </TableRow>

    <TableRow ScaleHeight="True">
      <comcom:GKListView x:Name="lvRecords" Height="480" />
    </TableRow>

    <TableRow>
      <TextArea x:Name="mSyncRes" ReadOnly="true" Height="160" />
    </TableRow>
  </TableLayout>

</Dialog>
