<?xml version="1.0" encoding="UTF-8"?>
<Panel xmlns="http://schema.picoe.ca/eto.forms" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:forms="clr-namespace:GKUI.Components"
  xmlns:comcom="clr-namespace:GKUI.Components;assembly=GKComponents"
  x:Class="GKUI.Components.ACOptionsControl">

  <StackLayout Padding="8" Spacing="4">

    <TableLayout Spacing="4, 4">

      <TableRow>
        <comcom:GKSwatchPanel x:Name="acb0" LabelName="lblAC0" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acb1" LabelName="lblAC1" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acb2" LabelName="lblAC2" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acb3" LabelName="lblAC3" Size="100, 20" Click="lblColorClick" />
        <TableCell ScaleWidth="True" />
      </TableRow>

      <TableRow>
        <comcom:GKSwatchPanel x:Name="acb4" LabelName="lblAC4" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acb5" LabelName="lblAC5" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acb6" LabelName="lblAC6" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acb7" LabelName="lblAC7" Size="100, 20" Click="lblColorClick" />
        <TableCell ScaleWidth="True" />
      </TableRow>

      <TableRow>
        <comcom:GKSwatchPanel x:Name="acbText" LabelName="lblACText" Size="100, 20" TextColor="White" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acbBack" LabelName="lblACBack" Size="100, 20" Click="lblColorClick" />
        <comcom:GKSwatchPanel x:Name="acbLine" LabelName="lblACLine" Size="100, 20" TextColor="White" Click="lblColorClick" />
      </TableRow>

    </TableLayout>

    <CheckBox x:Name="chkHideEmptySegments" />
    <CheckBox x:Name="chkArcText" />
    <StackLayoutItem Expand="True" />

  </StackLayout>

</Panel>
